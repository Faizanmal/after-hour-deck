ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Primary database. If this host is unreachable, the API falls back to SQLite.
DATABASE_URL=postgresql+psycopg://afterhours:afterhours@localhost:5432/afterhours

# Used when PostgreSQL is unavailable.
SQLITE_URL=sqlite:///./clinic.db

CLINIC_TZ=America/New_York
CLINIC_NAME=Riverside Family Dental
AGENT_VOICE=alba

# Public demo link. Leave PUBLIC_DEMO blank for local use.
# Presentation URL: https://your-host/?code=your-code-here
PUBLIC_DEMO=false
DEMO_ACCESS_CODE=
# Voice-call caps while PUBLIC_DEMO is true. Per network, then for the whole demo, per hour.
SESSION_LIMIT_PER_IP=30
SESSION_LIMIT_GLOBAL=80

# Comma-separated browser origins. Add the Vercel URL if it is not a *.vercel.app host.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3005,http://127.0.0.1:3005

# Set true only on Cloud Run, where Google appends the real client IP.
TRUST_PROXY=false
